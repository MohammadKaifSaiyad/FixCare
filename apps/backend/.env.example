DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fixcare_dev?schema=public"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fixcare_test?schema=public"
NODE_ENV="development"
PORT="3000"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="CHANGE_ME_min_32_chars"
JWT_ACCESS_TTL="15m"
REFRESH_TTL_DAYS="30"
OTP_TTL_SECONDS="300"
OTP_MAX_SENDS_PER_WINDOW="3"
OTP_SEND_WINDOW_SECONDS="900"
OTP_MAX_VERIFY_ATTEMPTS="5"

# Cloudflare R2 (photo evidence) — leave empty until the account is provisioned
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Razorpay (UPI payments). Leave ALL THREE empty to use the offline dev gateway (no
# network — fake order ids; the app shows "UPI unavailable, pay by cash"). Set all three
# (test-mode rzp_test_* keys work) to use the REAL Razorpay gateway even in development:
# /pay then creates a real order and the app's checkout sheet works. UPI reaches "Paid"
# only via the payment.captured webhook, so a public tunnel to /webhooks/razorpay
# (e.g. `cloudflared tunnel --url http://localhost:3000`) registered in the Razorpay
# dashboard with RAZORPAY_WEBHOOK_SECRET is required. Partial keys → dev gateway (fail safe).
# (The test suite forces these empty via vitest.config.ts, so tests always run offline.)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Cash path (B6b) — optional, these are the defaults. Flat new-tech debt limit + 24h velocity cap.
# CASH_DEBT_LIMIT_PAISE=50000
# CASH_VELOCITY_CAP_PAISE=300000

# Settlement (B6c) — optional, defaults shown. Commission bps (2000 = 20% platform).
# COMMISSION_RATE_BPS=2000
# DISPUTE_WINDOW_HOURS=48
# SETTLEMENT_SWEEP_INTERVAL_MINUTES=15

SEED_ADMIN_EMAIL="admin@fixcare.in"
SEED_ADMIN_PASSWORD="CHANGE_ME_min_8_chars"
