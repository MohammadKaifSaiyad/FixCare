<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY network security config.

  Android 9+ (API 28+) blocks cleartext HTTP by default. The local dev backend
  is plain HTTP (http://10.0.2.2:3000 from the Android emulator, or localhost),
  so debug builds need an explicit cleartext allowance — scoped to exactly the
  dev hosts, nothing else. This file lives under src/debug only, so it never
  ships in a release build: release traffic stays HTTPS-only with the platform
  default (cleartext blocked everywhere).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator's alias for the host machine's localhost. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- Genymotion / some setups reach the host at this address. -->
        <domain includeSubdomains="false">10.0.3.2</domain>
    </domain-config>
</network-security-config>
